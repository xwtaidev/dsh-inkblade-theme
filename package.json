{
  "name": "@xwtaidev/dsh-theme-inkblade",
  "version": "1.0.0",
  "description": "Inkblade paper-and-ink theme for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "xwtaidev",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "LICENSE", "README.md"],
  "scripts": { "test": "node --test test/*.test.js" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
